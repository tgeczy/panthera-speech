# Nothing of Apple's is ever committed -- package.py refuses to ship it and
# check_clean.py refuses to ship this machine's paths, but neither of them
# looks at rendered audio.  These are Apple's voices speaking.
*.wav
out/

build/
__pycache__/
*.pyc
*.obj
*.exe
