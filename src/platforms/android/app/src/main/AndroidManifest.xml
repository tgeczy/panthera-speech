<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Who answers a request to choose a document: needed since Android 11
         for the app to ask before opening the picker, so a watch's stub can
         be recognised and refused with a sentence instead of a shrug. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- For "Check for updates" on the Setup page, and nothing else: the app
         reaches the network only when that button is pressed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Every service says it can run before the phone is first unlocked,
             the engine and its four workers alike: the engine binds the
             workers, and binding a service that has not said so fails while
             the user is locked.  With the data in device-protected storage,
             that is what lets a screen reader read the lock screen after a
             reboot with these voices; see ProtectedStorage.kt. -->
        <service android:name=".TigerWorkerService" android:process=":tiger" android:exported="false" android:directBootAware="true" />
        <service android:name=".LeopardWorkerService" android:process=":leopard" android:exported="false" android:directBootAware="true" />
        <service android:name=".SnowLeopardWorkerService" android:process=":snowleopard" android:exported="false" android:directBootAware="true" />
        <service android:name=".LionWorkerService" android:process=":lion" android:exported="false" android:directBootAware="true" />

        <service
            android:name=".PantheraTtsService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/engine_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CheckVoiceDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GetSampleTextActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
